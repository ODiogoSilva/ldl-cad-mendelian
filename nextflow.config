nextflow.enable.dsl = 2

params {
  outdir          = 'results'

  // Public input data (verified 2026-11-03)
  ldl_url         = 'https://csg.sph.umich.edu/willer/public/lipids2013/jointGwasMc_LDL.txt.gz'
  cad_url         = 'https://ftp.ebi.ac.uk/pub/databases/gwas/summary_statistics/GCST003001-GCST004000/GCST003116/cad.add.160614.website.txt'
  panel_url       = 'https://zenodo.org/api/records/14142263/files/g1000_eur.zip/content'

  // Instrument selection
  pval_threshold  = 5e-8
  clump_kb        = 10000
  clump_r2        = 0.001

  // PCSK9 locus, GRCh37/hg19 coordinates (+/- 300 kb window)
  pcsk9_chr       = 1
  pcsk9_start     = 55205470
  pcsk9_end       = 55830520

  // CAD study size (Nikpay et al. 2015, Nature Genetics)
  cad_n           = 184305
  cad_ncase       = 60801
  cad_ncontrol    = 123504
}

process {
  errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
  maxRetries    = 3

  withName: DOWNLOAD  { container = 'alpine:3.20.3';                                  cpus = 2; memory = '4 GB';  time = '12h' }
  withName: HARMONIZE { container = 'rocker/verse:4.3.2';                             cpus = 4; memory = '16 GB'; time = '6h'  }
  withName: CLUMP     { container = 'quay.io/biocontainers/plink:1.90b6.21--h7b50bb2_7'; cpus = 4; memory = '16 GB'; time = '6h' }
  withName: MR        { container = 'rocker/verse:4.3.2';                             cpus = 4; memory = '16 GB'; time = '6h'  }
  withName: FINEMAP   { container = 'rocker/verse:4.3.2';                             cpus = 4; memory = '16 GB'; time = '6h'  }
  withName: REPORT    { container = 'rocker/verse:4.3.2';                             cpus = 4; memory = '16 GB'; time = '6h'  }
}
